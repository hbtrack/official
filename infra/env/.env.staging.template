# ============================================================================
# HB Track — Staging Environment Template
# Copiar para /opt/hbtrack/staging/.env e preencher todos os CHANGE_ME_*
#
# NUNCA commitar este arquivo com valores reais preenchidos.
# ============================================================================

# ── Docker / Registry ───────────────────────────────────────────────────────
REGISTRY=ghcr.io/hbtrack
IMAGE_TAG=latest

# ── Nginx config (staging usa nginx.staging.conf; produção usa nginx.conf) ──
NGINX_CONF=nginx.staging.conf

# ── Django ──────────────────────────────────────────────────────────────────
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY_50_CHARS_MINIMUM
DEBUG=false
ALLOWED_HOSTS=staging.handballtrack.app

# ── Database (Django app) ───────────────────────────────────────────────────
DB_NAME=hb_track
DB_USER=hbtrack
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_TEST_NAME=hb_track_test

# ── Database (PostgreSQL container) ─────────────────────────────────────────
# Deve ser idêntico a DB_NAME / DB_USER / DB_PASSWORD acima
POSTGRES_DB=hb_track
POSTGRES_USER=hbtrack
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TIMEZONE=America/Sao_Paulo

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.handballtrack.app

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── JWT / RS256 ─────────────────────────────────────────────────────────────
# Gerar com: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Armazenar como PEM base64 sem quebras ou multiline literal conforme ADR-012.
JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PEM_PRIVATE_KEY
JWT_PUBLIC_KEY=CHANGE_ME_BASE64_PEM_PUBLIC_KEY

# ── Cloudinary (uploads de imagem) ──────────────────────────────────────────
# Obter em: https://cloudinary.com/console
CLOUDINARY_URL=CHANGE_ME_cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_API_SECRET
CLOUDINARY_UPLOAD_PRESET=hb_profile_photo

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=suporte@handballtrack.app
RESEND_FROM_NAME=Handball Track

# ── AI / Google Gemini ──────────────────────────────────────────────────────
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
