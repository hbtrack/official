# ============================================================================
# HB Track — Production Environment Template
# Copiar para /opt/hbtrack/production/.env e preencher todos os CHANGE_ME_*
#
# NUNCA commitar este arquivo com valores reais preenchidos.
# ============================================================================

# ── Docker / Registry ────────────────────────────────────────────────────────
REGISTRY=ghcr.io/hbtrack
IMAGE_TAG=latest

# ── Nginx config ─────────────────────────────────────────────────────────────
NGINX_CONF=nginx.conf

# ── Django ────────────────────────────────────────────────────────────────────
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY_50_CHARS_MINIMUM
DEBUG=false
ALLOWED_HOSTS=handballtrack.app,www.handballtrack.app

# ── Database (Django app) ────────────────────────────────────────────────────
DB_NAME=hb_track
DB_USER=hbtrack
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_TEST_NAME=hb_track_test

# ── Database (PostgreSQL container) ──────────────────────────────────────────
# Deve ser idêntico a DB_NAME / DB_USER / DB_PASSWORD acima
POSTGRES_DB=hb_track
POSTGRES_USER=hbtrack
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── JWT / Autenticação ────────────────────────────────────────────────────────
# Algoritmo: RS256 (produção recomendado) ou HS256 (simétrico, mais simples)
JWT_ALGORITHM=RS256

# Para RS256: gere com scripts/generate_jwt_keys.sh (produz par PEM em base64)
# Para HS256: use: python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_PRIVATE_KEY=CHANGE_ME_RSA_PRIVATE_KEY_PEM_OR_BASE64
JWT_PUBLIC_KEY=CHANGE_ME_RSA_PUBLIC_KEY_PEM_OR_BASE64
# Usado apenas se JWT_ALGORITHM=HS256:
JWT_SECRET=CHANGE_ME_JWT_SECRET_50_CHARS_MINIMUM

JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TIMEZONE=America/Sao_Paulo

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://handballtrack.app,https://www.handballtrack.app

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── Cloudinary (uploads de imagem) ───────────────────────────────────────────
# Obter em: https://cloudinary.com/console
CLOUDINARY_URL=CHANGE_ME_cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_API_SECRET
CLOUDINARY_UPLOAD_PRESET=hb_profile_photo

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=suporte@handballtrack.app
RESEND_FROM_NAME=Handball Track

# ── AI / Google Gemini ────────────────────────────────────────────────────────
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
