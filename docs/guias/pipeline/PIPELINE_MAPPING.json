    "pipeline_structure": {
        "phases": [
            {
                "phase_id": "pre_contract",
                "order": 0,
                "name": "Pre-Contract Foundation",
                "purpose": "Validar entrada, determinar task_type correto, carregar boot profile, validar MODULE_REGISTRY",
                "gates": [
                    "AXIOM_INTEGRITY_GATE",
                    "PATH_CANONICALITY_GATE",
                    "SCOPE_BOUNDARY_GATE",
                    "MODULE_SOURCE_AUTHORITY_MATRIX_GATE",
                    "MODULE_REGISTRY_GATE",
                    "PRE_CONTRACT_EVIDENCE_GATE",
                    "SHADOW_AUTHORITY_GATE",
                    "CANON_ALLOWLIST_GATE",
                    "TOOLING_CONFIG_GATE"
                ],
                "mandatory_entry": true,
                "blocking_criteria": "any gate blocking"
            },
            {
                "phase_id": "decision_discovery",
                "order": 1,
                "name": "Architecture Decision Discovery",
                "purpose": "Analisar decisões arquiteturais abertas, criar/atualizar ADRs",
                "gates": [],
                "boot_profile": "architecture_decision",
                "task_types": [
                    "architecture_review"
                ],
                "blocking_criteria": "decisões abertas não resolvidas"
            },
            {
                "phase_id": "authoring",
                "order": 2,
                "name": "Authoring & Artifact Generation",
                "purpose": "Criar artefatos de contrato (OpenAPI, AsyncAPI, Arazzo, Schemas, UIs, Docs)",
                "gates": [
                    "REQUIRED_ARTIFACT_PRESENCE_GATE",
                    "MODULE_DOC_CROSSREF_GATE"
                ],
                "task_types": [
                    "new_module",
                    "new_contract",
                    "contract_revision",
                    "new_event",
                    "new_workflow",
                    "new_schema",
                    "new_state_model",
                    "new_ui_contract"
                ],
                "output_location": "contracts/, docs/hbtrack/modulos/, generated/",
                "requires_worker_prompt": true,
                "blocking_criteria": "artefato não escrito no path canônico"
            },
            {
                "phase_id": "validation",
                "order": 3,
                "name": "Contract Validation",
                "purpose": "Executar todos os gates de validação semântica e sintática",
                "gates": [
                    "API_NORMATIVE_DUPLICATION_GATE",
                    "OWASP_API_CONTROL_MATRIX_GATE",
                    "BOUNDARY_USERS_IDENTITY_ACCESS_GATE",
                    "WELLNESS_MEDICAL_BOUNDARY_GATE",
                    "SCOUT_TAXONOMY_GATE",
                    "ASYNC_REQUIRED_MODULE_GATE",
                    "EXTERNAL_SOURCE_AUTHORITY_GATE",
                    "DECISION_IR_CONFORMANCE_GATE",
                    "PLACEHOLDER_RESIDUE_GATE",
                    "REF_HERMETICITY_GATE"
                ],
                "script": "python3 scripts/contracts/validate/validate_contracts.py",
                "output_report": "_reports/contract_gates/latest.json",
                "blocking_criteria": "any blocking gate fails"
            },
            {
                "phase_id": "readiness",
                "order": 4,
                "name": "Module Readiness & Promotion",
                "purpose": "Validar que módulo elegível para implementation_ready (todas superfícies presentes, testes verdes, 0 decisões abertas)",
                "gates": [
                    "MODULE_REGISTRY_GATE",
                    "PRE_CONTRACT_EVIDENCE_GATE"
                ],
                "task_types": [
                    "readiness_promotion"
                ],
                "output": "MODULE_REGISTRY.yaml atualizado com status=implementation_ready",
                "blocking_criteria": "superfícies faltando ou decisões abertas"
            },
            {
                "phase_id": "implementation_handoff",
                "order": 5,
                "name": "Implementation Handoff",
                "purpose": "Registrar evidência final pré-contrato, liberar para codificação",
                "gates": [],
                "output": "SESSION_HANDOFF.md finalizado, git commit",
                "blocking_criteria": "nenhuma — handoff é registro de evidência"
            }
        ],
        "compilation_step": {
            "purpose": "Aplicar policies globais e reconfiguração pós-mudança de artefatos globais",
            "script": "python3 scripts/contracts/validate/api/compile_api_policy.py",
            "trigger": "após mudança em artefatos globais (DOMAIN_AXIOMS.json, api_rules.yaml, etc.)",
            "required_before_revalidation": true
        },
        "maximum_concurrent_gates": 3,
        "note": "Sem pular fases; nenhuma implementação antes de Validation + Readiness"
    },
