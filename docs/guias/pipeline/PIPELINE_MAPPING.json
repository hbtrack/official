    "boot_profiles": {
        "total": 4,
        "definition_source": ".contract_driven/BOOT_PROFILES.yaml",
        "profiles": [
            {
                "profile_id": "default",
                "description": "Boot mínimo para qualquer agent",
                "load_sequence": [
                    "docs/_canon/AGENT_INSTRUCTIONS.md",
                    "docs/_canon/OPERATIONS.md",
                    "README.md"
                ],
                "required_sections": [
                    "AGENT_INSTRUCTIONS.md§0 (Leia Primeiro)",
                    "AGENT_INSTRUCTIONS.md§1 (Modo de operação)",
                    "AGENT_INSTRUCTIONS.md§2 (Sistema: O que é)",
                    "AGENT_INSTRUCTIONS.md§3 (16 Módulos Canônicos)",
                    "AGENT_INSTRUCTIONS.md§4 (Task Types → Workers)",
                    "AGENT_INSTRUCTIONS.md§5 (Bloqueios)",
                    "AGENT_INSTRUCTIONS.md§6 (Regras Core)"
                ],
                "validations": [
                    "task_type_in_catalog",
                    "module_in_registry",
                    "worker_prompt_exists"
                ],
                "exit_on_fail": true
            },
            {
                "profile_id": "contract_execution",
                "description": "Boot para task de contrato (new_contract, new_event, etc)",
                "load_sequence": [
                    "docs/_canon/AGENT_INSTRUCTIONS.md",
                    "docs/_canon/OPERATIONS.md",
                    "docs/_canon/CONTRACT_PIPELINE.md",
                    "contracts/schemas/shared/session_start.schema.json",
                    ".contract_driven/CONTRACT_SYSTEM_RULES.md",
                    "docs/_canon/gates/GATES_REGISTRY.yaml"
                ],
                "required_sections": [
                    "AGENT_INSTRUCTIONS.md§0,3,4,5,6",
                    "CONTRACT_PIPELINE.md§1 (Pipeline de Fases)",
                    "GATES_REGISTRY.yaml§metadata"
                ],
                "validations": [
                    "session_start_valid",
                    "task_type_active",
                    "boot_profile_in_session",
                    "stage_in_range"
                ],
                "exit_on_fail": true
            },
            {
                "profile_id": "architecture_decision",
                "description": "Boot para Decision Discovery",
                "load_sequence": [
                    "docs/_canon/AGENT_INSTRUCTIONS.md",
                    "docs/_canon/OPERATIONS.md",
                    "docs/_canon/ARCHITECTURE_DECISION_BACKLOG.md",
                    "docs/_canon/DECISION_POLICY.md",
                    "docs/_canon/gates/GATES_REGISTRY.yaml"
                ],
                "required_sections": [
                    "AGENT_INSTRUCTIONS.md§0,1,2",
                    "DECISION_POLICY.md§triggers"
                ],
