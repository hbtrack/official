# ============================================================================
# HB Track — .gitignore
# Stack: Django 5.x + React/Vite + PostgreSQL 16 + Redis 7 + Celery 5
# Atualizado: 2026-04-10 (SAN-006)
# ============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-wheel-metadata/
.tox/
.hypothesis/
.ruff_cache/

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/

# ── Build / Test artifacts ───────────────────────────────────────────────────
build/
dist/
.reports/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
celerybeat-schedule*
*.sqlite3

# ── Environment and secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
id_ed25519
id_ed25519.*

# ── VPS documentation (contains credentials, IPs, SSH keys) ─────────────────
/VPS/
!/VPS/templates/

# ── Generated reports (DO NOT VERSION) ───────────────────────────────────────
report*.json
report*.txt
validation_report.txt
docs/scripts/consolidated_report.json
docs/_generated/
# Exception: canonical JSON schemas inside contracts/ (required by REQUIRED_ARTIFACT_PRESENCE_GATE)
!contracts/schemas/**/*.schema.json
# Exception: canonical schemas inside generated/contracts/ (referenced by traceability manifests — DERIVED_DRIFT_GATE)
!generated/contracts/**/*.schema.json

# ── Agent runtime signals (ephemeral, never version) ────────────────────────
_reports/dispatch/
_reports/execution_evidence/
_reports/runs/
_reports/openapi/
_reports/ARQUITETO.yaml
_reports/EXECUTOR.yaml
_reports/TESTADOR.yaml
# _reports/agent_execution/ tracked: baseline_backfill evidence required by PRE_CONTRACT_EVIDENCE_GATE

# ── .CEPRAEA/ — material de pesquisa/planejamento histórico (SAN-016, 2026-04-10) ──
# Zero consumidores em scripts/hb, validate_contracts.py, workflows, .contract_driven/.
# Conteúdo: auditorias históricas, análises de paridade, video_pipeline offline.
# Todos os 29 arquivos rastreados são artefatos derivados non-sovereign; não há valor
# em versionar novos arquivos neste diretório.
.CEPRAEA/

# ── _reports/ retention policy (SAN-014, 2026-04-10) ────────────────────────
# Consumidores ativos confirmados (MANTER VERSIONADO — não adicionar aqui):
#   contract_gates/latest.json, contract_gates/*.latest.json (scripts/hb + validate_contracts.py + merge-readiness.json)
#   preflight/latest.json (validate_contracts.py + merge-readiness.json)
#   session_start.json (scripts/hb + validate_contracts.py)
#   adversarial/ (ADVERSARIAL_GATE em validate_contracts.py)
#   agent_execution/*.json (PRE_CONTRACT_EVIDENCE_GATE em validate_contracts.py)
#   compliance/agent_operability_latest.json (pre-push / SESSION_HANDOFF)
#   evidence/boot_resolution_report.json (validate_contracts.py)
#   legacy/ (scripts/hb — migração de sessões antigas)
#   DOMAIN_COMPLETENESS_*.json/md (gerado + commitado por workflow domain-completeness-audit.yml)
#
# Histórico sem consumidor ativo — ignorar novos arquivos:
_reports/enforcement/
_reports/parity/
_reports/RED_TEAM_AUDIT_LATEST.json
_reports/SOVEREIGN_INTEGRITY_AUDIT_LATEST.json
_reports/staging_revalidation/
# Nota: 118 arquivos raiz de histórico de sessão (AUDIT_*, BACKLOG_2C_*, C4_*, etc.)
# já estão commitados como registro histórico congelado. Não adicionar novos.
# Para destravar: `git rm --cached _reports/enforcement/ _reports/parity/` quando conveniente.
# Para remover histórico raiz: `git rm --cached _reports/*.md _reports/*.txt` (exceto session_start.json)

# ── HB Track local runtime ──────────────────────────────────────────────────
.hb_guard/
.hb_backups/
.hb_lock
.hb_tmp_tests/

# ── Windows NTFS metadata (SAN-017, 2026-04-10) ─────────────────────────────
# Gerados ao baixar arquivos no Windows; sem valor em Linux/WSL
*:Zone.Identifier

# ── Logs and caches ─────────────────────────────────────────────────────────
*.log
!docs/hbtrack/evidence/**/*.log
# Exception: validation logs inside contracts/ referenced by drift manifests
!contracts/**/*.log
# Exception: validation logs inside generated/contracts/ referenced by traceability manifests (DERIVED_DRIFT_GATE)
!generated/contracts/**/*.log
logs/
.cache/

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo

# ── Local/invalid placeholders on Windows ────────────────────────────────────
nul
*/nul

# ── Archives (no physical delete policy) ─────────────────────────────────────
_archived/
**/_archived/
**/_archived/**
_archived_e2e/
/archive
archive/

# ── Agents / local agent files ───────────────────────────────────────────────
# Note: .github/agents/ is TRACKED (canonical governance structure)
/agents/
docs/agents/
scripts/agents/
*.agent

# ── Dev local ────────────────────────────────────────────────────────────────
.dev/
temp/
brain-gist/

# ── Alembic review artifacts (legacy, still useful to ignore) ────────────────
review.sql
review_*.sql

# ── Session handoff typo variants (prevent accidental commits) ───────────────
SESSION_HANDOOF*

# ── Temporary batch scripts ──────────────────────────────────────────────────
tmp_*.ps1

# ── Evidence packs (ARCH-DOCS-ARTIFACTS-002) ─────────────────────────────────
docs/execution_tasks/artifacts/**/*.zip
docs/execution_tasks/artifacts/**/*.tar.gz
docs/execution_tasks/artifacts/**/*.tgz
docs/execution_tasks/artifacts/**/*.7z

# ── Audit output ─────────────────────────────────────────────────────────────
_reports/audit/KANBAN_*
_audit_output.txt

# ── Legacy separate repos (merged into monorepo — paths no longer exist) ─────
Hb Track - Backend/
Hb Track - Fronted/
