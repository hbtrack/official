        "OVERLOAD_RISK",
        "ADHERENCE_DROP",
        "WELLNESS_ALERT",
        "PENDING_REVIEW_OVERDUE",
        "EXECUTION_DEVIATION",
        "CONSTRAINT_OVERRIDE_REQUIRED"
