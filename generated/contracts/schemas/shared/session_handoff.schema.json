{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hbtrack.local/schemas/session_handoff.schema.json",
    "title": "HB Track — Session Handoff",
    "description": "Schema ativo para o front matter YAML obrigatório de SESSION_HANDOFF.md. O HANDOFF_COHERENCE_GATE valida esse front matter contra este contrato antes de aceitar a continuidade entre sessões.",
    "$comment": "Este schema governa apenas o front matter YAML do markdown operacional SESSION_HANDOFF.md. O corpo textual continua delta-only e deve manter as seções exigidas pelo template canônico.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "data_ultima_sessao",
        "branch_ativo",
        "modo_operacao",
        "ci_status",
        "modulo_foco",
        "fase_roadmap",
        "task_type",
        "boot_profile_id",
        "task_id",
        "resultado",
        "proxima_acao_permitida",
        "bloqueios_ativos",
        "evidence_paths"
    ],
    "if": {
        "properties": {
            "task_type": {
                "const": "execute_roadmap_phase"
            }
        },
        "required": [
            "task_type"
        ]
    },
    "then": {
        "required": [
            "roadmap_phase"
        ]
    },
    "properties": {
        "data_ultima_sessao": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Data ISO (YYYY-MM-DD) da última sessão consolidada neste handoff."
        },
        "branch_ativo": {
            "type": "string",
            "minLength": 1,
            "description": "Branch Git em que o handoff foi gerado."
        },
        "modo_operacao": {
            "type": "string",
            "enum": [
                "CDD",
                "ROADMAP"
            ],
            "description": "Modo operacional consolidado neste handoff."
        },
        "ci_status": {
            "type": "string",
            "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN"
            ],
            "description": "Estado consolidado da validação disponível no fechamento da sessão."
        },
        "modulo_foco": {
            "type": "string",
            "minLength": 1,
            "description": "Módulo, trilha ou área principal focada na sessão."
        },
        "fase_roadmap": {
            "type": "integer",
            "minimum": 0,
            "description": "Fase atual do ROADMAP operacional."
        },
        "roadmap_phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 13,
            "description": "Fase do ROADMAP sendo executada. Obrigatório quando task_type=execute_roadmap_phase. Espelha fase_roadmap e alinha com session_start.roadmap_phase para validação cruzada pelo HANDOFF_COHERENCE_GATE."
        },
        "task_type": {
            "type": "string",
            "minLength": 1,
            "description": "task_type operacional associado ao estado consolidado."
        },
        "boot_profile_id": {
            "type": "string",
            "enum": [
                "default",
                "contract_execution",
                "architecture_decision",
                "diagnostic",
                "roadmap_execution",
                "implementation_execution",
                "adversarial_validation"
            ],
            "description": "Boot profile declarado para o estado consolidado."
        },
        "task_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador da tarefa atual ou último task_id concluído."
        },
        "resultado": {
            "type": "string",
            "enum": [
                "DONE",
                "PENDENTE",
                "BLOCKED"
            ],
            "description": "Resultado consolidado da sessão no ponto em que o handoff foi gerado."
        },
        "proxima_acao_permitida": {
            "type": "string",
            "minLength": 10,
            "description": "Próxima ação objetiva permitida para a sessão seguinte."
        },
        "bloqueios_ativos": {
            "type": "array",
            "description": "Lista de bloqueios ainda ativos. Use lista vazia quando não houver bloqueios.",
            "items": {
                "type": "string",
                "minLength": 3
            }
        },
        "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "description": "Paths de evidência usados para sustentar o estado do handoff.",
            "items": {
                "type": "string",
                "minLength": 10
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "task_type": {
                        "enum": [
                            "implementation_execution",
                            "adversarial_test_execution"
                        ]
                    }
                },
                "required": [
                    "task_type"
                ]
            },
            "then": {
                "properties": {
                    "evidence_paths": {
                        "contains": {
                            "type": "string",
                            "pattern": "^_reports/implementation_flow/"
                        }
                    }
                }
            }
        }
    ],
    "examples": [
        {
            "data_ultima_sessao": "2026-03-23",
            "branch_ativo": "hb-track-contratos-driven",
            "modo_operacao": "ROADMAP",
            "ci_status": "PASS",
            "modulo_foco": "governance",
            "fase_roadmap": 1,
            "roadmap_phase": 1,
            "task_type": "execute_roadmap_phase",
            "boot_profile_id": "roadmap_execution",
            "task_id": "phase-1-foundation",
            "resultado": "PENDENTE",
            "proxima_acao_permitida": "Executar a Fase 1 do ROADMAP.md com foco em infraestrutura base e revalidar os gates.",
            "bloqueios_ativos": [],
            "evidence_paths": [
                "_reports/runs/20260323T190000_ab12cd/contract_gates.json",
                "_reports/runs/20260323T190000_ab12cd/health.json"
            ]
        }
    ]
}
