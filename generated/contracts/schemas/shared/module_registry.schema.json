{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbtrack.local/contracts/schemas/shared/module_registry.schema.json",
  "title": "HB Track — Module Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact", "status", "scope", "policy", "modules"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifact": { "type": "string", "const": "MODULE_REGISTRY" },
    "status": { "type": "string", "enum": ["active", "inactive"] },
    "scope": { "type": "string", "enum": ["global"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "status_semantics", "surface_catalog"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "status_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scaffold", "draft_contract", "validated_contract", "implementation_ready"],
          "properties": {
            "scaffold": { "type": "string", "minLength": 1 },
            "draft_contract": { "type": "string", "minLength": 1 },
            "validated_contract": { "type": "string", "minLength": 1 },
            "implementation_ready": { "type": "string", "minLength": 1 }
          }
        },
        "surface_catalog": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "module_docs_minimum",
              "openapi_sync",
              "json_schema",
              "test_matrix",
              "state_model",
              "permissions",
              "errors",
              "sport_science",
              "ui_contract",
              "arazzo",
              "asyncapi",
              "decision_ir"
            ]
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/moduleEntry" }
    }
  },
  "$defs": {
    "moduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "expected_surfaces"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["scaffold", "draft_contract", "validated_contract", "implementation_ready"]
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "expected_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "module_docs_minimum",
              "openapi_sync",
              "json_schema",
              "test_matrix",
              "state_model",
              "permissions",
              "errors",
              "sport_science",
              "ui_contract",
              "arazzo",
              "asyncapi",
              "decision_ir"
            ]
          }
        }
      }
    }
  }
}
