{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hbtrack.dev/schemas/merge-readiness",
    "title": "HB Track Merge-Readiness Manifest",
    "description": "Contrato executável de prontidão pré-push e merge-readiness. v2: inclui execution_plan, diff_classification, semantic_requirements, reviewability e pr_fix_resolution.",
    "type": "object",
    "required": [
        "version",
        "target_branch",
        "ruleset_name",
        "checks",
        "enforcement",
        "local_executor",
        "execution_plan",
        "diff_classification",
        "semantic_requirements",
        "reviewability",
        "pr_fix_resolution"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^2\\.\\d+\\.\\d+$",
            "description": "Versão major travada em 2.x — bump consciente de ruptura para v3."
        },
        "updated": {
            "type": "string",
            "format": "date"
        },
        "target_branch": {
            "type": "string"
        },
        "ruleset_name": {
            "type": "string"
        },
        "ruleset_id": {
            "type": "integer"
        },
        "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "context",
                    "workflow",
                    "job",
                    "category"
                ],
                "additionalProperties": false,
                "properties": {
                    "context": {
                        "type": "string",
                        "description": "Nome exato do check context como registrado no ruleset do GitHub."
                    },
                    "workflow": {
                        "type": "string",
                        "description": "Arquivo de workflow (.yml) que contém o job."
                    },
                    "job": {
                        "type": "string",
                        "description": "ID do job dentro do workflow."
                    },
                    "category": {
                        "type": "string",
                        "enum": [
                            "required",
                            "informational",
                            "conditional"
                        ],
                        "description": "required = bloqueia merge no ruleset. informational = roda mas não bloqueia. conditional = roda apenas quando condição de path-filter é verdadeira."
                    },
                    "local_equivalent": {
                        "type": "string",
                        "description": "Comando local que reproduz este check. Obrigatório para category=required."
                    },
                    "local_equivalent_kind": {
                        "type": "string",
                        "enum": [
                            "exact_job",
                            "aggregate_executor",
                            "approximation"
                        ],
                        "description": "Grau de fidelidade do local_equivalent em relação ao check remoto."
                    },
                    "condition": {
                        "type": "string",
                        "description": "Expressão que ativa o check. Obrigatório para category=conditional."
                    },
                    "reason": {
                        "type": "string",
                        "description": "Justificativa de não ser required. Obrigatório para category=informational e category=conditional."
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "category": {
                                    "const": "required"
                                }
                            },
                            "required": [
                                "category"
                            ]
                        },
                        "then": {
                            "required": [
                                "local_equivalent",
                                "local_equivalent_kind"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "category": {
                                    "const": "conditional"
                                }
                            },
                            "required": [
                                "category"
                            ]
                        },
                        "then": {
                            "required": [
                                "condition",
                                "reason"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "category": {
                                    "const": "informational"
                                }
                            },
                            "required": [
                                "category"
                            ]
                        },
                        "then": {
                            "required": [
                                "reason"
                            ]
                        }
                    }
                ]
            }
        },
        "enforcement": {
            "type": "object",
            "required": [
                "require_pr",
                "require_conversation_resolution",
                "require_up_to_date",
                "block_force_push",
                "bypass_actors"
            ],
            "additionalProperties": false,
            "properties": {
                "require_pr": {
                    "type": "boolean"
                },
                "require_conversation_resolution": {
                    "type": "boolean"
                },
                "require_up_to_date": {
                    "type": "boolean"
                },
                "block_force_push": {
                    "type": "boolean"
                },
                "block_deletion": {
                    "type": "boolean"
                },
                "bypass_actors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "local_executor": {
            "type": "object",
            "required": [
                "command",
                "evidence_path"
            ],
            "additionalProperties": false,
            "properties": {
                "command": {
                    "type": "string"
                },
                "evidence_path": {
                    "type": "string"
                },
                "pre_push_hook": {
                    "type": "string"
                }
            }
        },
        "execution_plan": {
            "type": "object",
            "required": [
                "baseline_steps",
                "required_check_strategy",
                "conditional_check_strategy",
                "decision_policy",
                "output_report"
            ],
            "additionalProperties": false,
            "properties": {
                "baseline_steps": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "survival_suite",
                            "diff_scan",
                            "schema_guard",
                            "handoff_guard"
                        ]
                    }
                },
                "required_check_strategy": {
                    "type": "string",
                    "enum": [
                        "run_all_required",
                        "run_required_by_scope"
                    ]
                },
                "conditional_check_strategy": {
                    "type": "string",
                    "enum": [
                        "activate_by_diff",
                        "activate_by_paths_and_rules"
                    ]
                },
                "decision_policy": {
                    "type": "string",
                    "enum": [
                        "block_on_required_fail",
                        "block_on_required_fail_or_missing_evidence",
                        "warn_on_missing_evidence"
                    ]
                },
                "output_report": {
                    "type": "string"
                }
            }
        },
        "diff_classification": {
            "type": "object",
            "required": [
                "classes"
            ],
            "additionalProperties": false,
            "properties": {
                "classes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "class_id",
                            "paths"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "class_id": {
                                "type": "string"
                            },
                            "paths": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "semantic_requirements": {
            "type": "object",
            "required": [
                "rules"
            ],
            "additionalProperties": false,
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "when",
                            "require",
                            "block_if_missing"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "when": {
                                "type": "string",
                                "enum": [
                                    "schema_field_removed",
                                    "new_cross_module_boundary",
                                    "canonical_status_transition",
                                    "diff_outside_handoff_scope",
                                    "bridge_doc_uses_authority_language"
                                ]
                            },
                            "require": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "block_if_missing": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "reviewability": {
            "type": "object",
            "required": [
                "max_changed_files",
                "max_commits",
                "max_cross_domain_areas",
                "split_required_when_exceeded"
            ],
            "additionalProperties": false,
            "properties": {
                "max_changed_files": {
                    "type": "integer",
                    "minimum": 1
                },
                "max_commits": {
                    "type": "integer",
                    "minimum": 1
                },
                "max_cross_domain_areas": {
                    "type": "integer",
                    "minimum": 1
                },
                "split_required_when_exceeded": {
                    "type": "boolean"
                }
            }
        },
        "pr_fix_resolution": {
            "type": "object",
            "required": [
                "finding_classes"
            ],
            "additionalProperties": false,
            "properties": {
                "finding_classes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "finding_id",
                            "action"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "finding_id": {
                                "type": "string",
                                "enum": [
                                    "defect_real",
                                    "governance_gap",
                                    "evidence_missing",
                                    "advisory_non_actionable"
                                ]
                            },
                            "action": {
                                "type": "string",
                                "enum": [
                                    "fix_repository",
                                    "fix_governance_artifact",
                                    "reply_with_evidence",
                                    "reply_without_scope_expansion"
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}