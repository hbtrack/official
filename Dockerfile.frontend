# ─────────────────────────────────────────────────────────
# HB Track — Dockerfile Frontend (multi-stage)
# Stage 1: build React/Vite
# Stage 2: Nginx serve dist/
# ─────────────────────────────────────────────────────────

FROM node:22-alpine AS builder

WORKDIR /app

# Install deps first (cache-friendly)
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

# Copy source and build
COPY frontend/ .
COPY generated/images/ /generated/images/
ARG VITE_API_URL=/api
ARG VITE_APP_VERSION=unknown
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}
RUN npm run build

# ─── Nginx stage ────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Custom config: SPA routing + proxy /api → backend
COPY infra/nginx/nginx-spa.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
