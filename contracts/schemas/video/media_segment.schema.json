{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbtrack.local/schemas/video/media_segment.schema.json",
  "title": "MediaSegment",
  "description": "Immutable fact: contiguous video segment with single timecode, codec, bitrate. References: DR-VID-001 (timecode unique), DR-VID-005 (immutability), INV-VID-005 (mezzanine source).",
  "type": "object",
  "required": ["id", "sessionId", "timecodeLogical", "state"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "format": "uuid"},
    "timecodeLogical": {"type": "integer", "minimum": 0, "description": "Milliseconds from match start (INV-VID-001: unique per session)"},
    "timecodeLabel": {"type": "string", "maxLength": 60},
    "state": {"type": "string", "enum": ["OPEN", "FINALIZED"], "description": "OPEN=writable, FINALIZED=immutable (DR-VID-005)"},
    "codecLabel": {"type": "string", "maxLength": 60},
    "bitrate": {"type": "integer", "minimum": 100, "description": "kbps"},
    "durationMs": {"type": "integer", "minimum": 100},
    "sourceEdgeNodeId": {"type": "string", "maxLength": 80},
    "createdAt": {"type": "string", "format": "date-time"},
    "finalizedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
