{
  "permissions": {
    "allow": [
      "Bash(GH_TOKEN=\"\" gh pr view 51 --json title,state,mergeable,mergeStateStatus,statusCheckRollup,reviews,reviewDecision)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/check_backend_gate.py",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/check_session_commit.py",
        "timeout": 10
      }
    ]
  }
}
