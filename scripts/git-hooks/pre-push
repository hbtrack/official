#!/usr/bin/env python3
"""
HB Track pre-push hook.

Executa o local_executor.command declarado em merge-readiness.json.
Semântica esperada do preflight v2:
  0 = PASS  -> permite push
  1 = WARN  -> permite push com aviso
  2 = BLOCK -> bloqueia push
"""

from __future__ import annotations

import json
import shlex
import subprocess
import sys
from pathlib import Path


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def _load_manifest(root: Path) -> dict:
    manifest_path = root / "merge-readiness.json"
    if not manifest_path.exists():
        print("❌ pre-push: merge-readiness.json não encontrado.", file=sys.stderr)
        raise SystemExit(2)
    return json.loads(manifest_path.read_text(encoding="utf-8"))


def _resolve_command(root: Path, command: str) -> list[str]:
    parts = shlex.split(command)
    if not parts:
        print("❌ pre-push: local_executor.command vazio.", file=sys.stderr)
        raise SystemExit(2)

    # Preferir Python da venv quando o executor local usa python/python3.
    if parts[0] in {"python", "python3"}:
        venv_python = root / ".venv" / "bin" / "python"
        if venv_python.exists():
            parts[0] = str(venv_python)
    return parts


def main() -> int:
    root = _repo_root()
    manifest = _load_manifest(root)
    local_executor = manifest.get("local_executor", {})
    command = str(local_executor.get("command") or "").strip()
    argv = _resolve_command(root, command)

    print("══ pre-push — merge-readiness local executor ══")
    print(f"command: {' '.join(argv)}")

    result = subprocess.run(argv, cwd=root)
    rc = result.returncode

    if rc == 0:
        print("✅ pre-push: PASS — push permitido.")
        return 0
    if rc == 1:
        print("⚠️  pre-push: WARN — push permitido com ressalvas.", file=sys.stderr)
        return 0

    print(f"❌ pre-push: BLOCK — push negado (exit {rc}).", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
