#!/usr/bin/env python3
"""
HB Track Pipeline CLI (v2 — PR2 Endurecimento)

Validação determinística contra SSOTs:
- BOOT_PROFILES.yaml (profiles de boot)
- TASK_CATALOG.yaml (task types mapeados)
- session_start.schema.json (schema de sessão)

DONE = exitcode 0. Não avançar de fase sem exitcode 0.

Mudanças em v2:
- hb verify --task-type <task> --module <mod> OBRIGATÓRIO (sem defaults)
- hb check --module <mod> OBRIGATÓRIO (sem defaults)
- hb artifact <path> com upsert por hash SHA-256
- hb reset para limpar sessão  
- Validação contra SSOTs antes de executar

B8-002: HTTP_RUNTIME_CONTRACT_GATE e PACT_PROVIDER_GATE são obrigatórios antes de `released`.
Ver docs/_canon/CONTRACT_PIPELINE.md §7 para detalhes.

Referência: .dev/planejamento/execut.md (Fase 2 — PR2)
"""

import argparse
import importlib.util
import json
import os
import pathlib
import shutil
import subprocess
import sys
from typing import Optional, Dict, Any
import hashlib
import uuid
from datetime import datetime, timezone

import yaml
import jsonschema


class HBCLIv2:
    """CLI v2 com validação determinística contra SSOTs."""

    LOCAL_TOOLCHAIN_BLOCK_CODE = "BLOCKED_LOCAL_TOOLCHAIN_MISSING"
    STAGE_NOT_ALLOWED_BLOCK_CODE = "BLOCKED_STAGE_NOT_ALLOWED"
    LOCAL_CONTRACT_VENV = ".venv-contract"
    
    def __init__(self):
        """Inicializar paths e carregar SSOTs."""
        self.root = self._get_workspace_root()
        self.session_file = self.root / "_reports/session_start.json"
        self.legacy_session_dir = self.root / "_reports/legacy"
        self.validator_script = self.root / "scripts/contracts/validate/validate_contracts.py"
        self.source_graph_compiler_script = self.root / "scripts/compile/compile_source_graph.py"
        self.ops_contract_compiler_script = self.root / "scripts/compile/compile_ops_contracts.py"
        self.context_bundle_compiler_script = self.root / "scripts/compile/compile_context_bundle.py"
        self.local_contract_venv = self.root / self.LOCAL_CONTRACT_VENV
        
        # Carregar SSOTs dos novos paths (.contract_driven)
        self.boot_profiles = self._load_yaml(self.root / ".contract_driven/BOOT_PROFILES.yaml")
        self.task_catalog = self._load_yaml(self.root / ".contract_driven/TASK_CATALOG.yaml")
        self.module_registry = self._load_yaml(self.root / "docs/_canon/MODULE_REGISTRY.yaml")
        self.session_schema = self._load_json(self.root / "contracts/schemas/shared/session_start.schema.json")
        
        self.session = self._load_session()
        
        # Detectar se sessão está obsoleta e migrar se necessário
        self._migrate_legacy_session_if_needed()
    
    @staticmethod
    def _get_workspace_root() -> pathlib.Path:
        """Obter raiz do workspace."""
        try:
            result = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                capture_output=True,
                text=True,
                check=True
            )
            return pathlib.Path(result.stdout.strip())
        except Exception:
            return pathlib.Path.cwd()
    
    @staticmethod
    def _load_yaml(path: pathlib.Path) -> Dict[str, Any]:
        """Carregar e parsear YAML."""
        if not path.exists():
            raise FileNotFoundError(f"SSOT não encontrado: {path}")
        with open(path) as f:
            return yaml.safe_load(f)
    
    @staticmethod
    def _load_json(path: pathlib.Path) -> Dict[str, Any]:
        """Carregar e parsear JSON."""
        if not path.exists():
            raise FileNotFoundError(f"Schema não encontrado: {path}")
        with open(path) as f:
            return json.load(f)

    def _local_contract_python_candidates(self) -> list[pathlib.Path]:
        candidates = [
            self.local_contract_venv / "bin" / "python",
            self.local_contract_venv / "Scripts" / "python.exe",
            pathlib.Path(sys.executable),
        ]
        seen: set[str] = set()
        unique: list[pathlib.Path] = []
        for candidate in candidates:
            key = str(candidate)
            if key in seen:
                continue
            seen.add(key)
            unique.append(candidate)
        return unique

    @staticmethod
    def _missing_python_modules(python_bin: pathlib.Path, modules: tuple[str, ...]) -> list[str]:
        if not python_bin.exists() or not modules:
            return []
        result = subprocess.run(
            [
                str(python_bin),
                "-c",
                (
                    "import importlib.util, json, sys; "
                    "mods=sys.argv[1:]; "
                    "missing=[m for m in mods if importlib.util.find_spec(m) is None]; "
                    "print(json.dumps(missing)); "
                    "raise SystemExit(0 if not missing else 1)"
                ),
                *modules,
            ],
            capture_output=True,
            text=True,
        )
        output = result.stdout.strip() or "[]"
        try:
            return json.loads(output)
        except json.JSONDecodeError:
            return list(modules)

    def _build_tool_env(self) -> dict[str, str]:
        env = os.environ.copy()
        tool_dirs = [
            self.local_contract_venv / "bin",
            self.local_contract_venv / "Scripts",
            self.root / "node_modules" / ".bin",
        ]
        current_path = env.get("PATH", "")
        prefixes = [str(path) for path in tool_dirs if path.exists()]
        if prefixes:
            joined = os.pathsep.join(prefixes)
            env["PATH"] = f"{joined}{os.pathsep}{current_path}" if current_path else joined
        return env

    def _missing_cli_tools(self, tools: tuple[str, ...]) -> list[str]:
        if not tools:
            return []
        env = self._build_tool_env()
        tool_path = env.get("PATH", "")
        missing = [tool for tool in tools if shutil.which(tool, path=tool_path) is None]
        return missing

    def _missing_cli_groups(self, groups: tuple[tuple[str, ...], ...]) -> list[str]:
        if not groups:
            return []
        env = self._build_tool_env()
        tool_path = env.get("PATH", "")
        missing: list[str] = []
        for group in groups:
            if not any(shutil.which(tool, path=tool_path) for tool in group):
                missing.append(" / ".join(group))
        return missing

    def _resolve_python_with_modules(self, modules: tuple[str, ...]) -> Optional[pathlib.Path]:
        for candidate in self._local_contract_python_candidates():
            if not candidate.exists():
                continue
            if not self._missing_python_modules(candidate, modules):
                return candidate
        return None

    def _ensure_local_contract_env(
        self,
        command_name: str,
        *,
        python_modules: tuple[str, ...] = (),
        cli_tools: tuple[str, ...] = (),
        cli_groups: tuple[tuple[str, ...], ...] = (),
    ) -> Optional[pathlib.Path]:
        python_bin = self._resolve_python_with_modules(python_modules)
        missing_parts: list[str] = []

        if python_bin is None and python_modules:
            missing_parts.append(f"módulos Python ausentes: {', '.join(python_modules)}")

        missing_tools = self._missing_cli_tools(cli_tools)
        if missing_tools:
            missing_parts.append(f"CLIs ausentes: {', '.join(missing_tools)}")

        missing_groups = self._missing_cli_groups(cli_groups)
        if missing_groups:
            missing_parts.append(f"grupos de CLI ausentes: {', '.join(missing_groups)}")

        if missing_parts:
            print(
                f"❌ {self.LOCAL_TOOLCHAIN_BLOCK_CODE}: ambiente local de contratos incompleto para '{command_name}'.",
                file=sys.stderr,
            )
            for part in missing_parts:
                print(f"   - {part}", file=sys.stderr)
            print(
                "   Execute: bash scripts/bootstrap/dev_contract_env.sh",
                file=sys.stderr,
            )
            return None

        return python_bin or pathlib.Path(sys.executable)
    
    def _load_session(self) -> Dict[str, Any]:
        """Carregar session_start.json ou retornar dict vazio."""
        if self.session_file.exists():
            try:
                with open(self.session_file) as f:
                    return json.load(f)
            except Exception as e:
                print(f"❌ Erro ao parsear session_start.json: {e}", file=sys.stderr)
                return {}
        return {}
    
    def _migrate_legacy_session_if_needed(self):
        """
        Detectar se sessão é de versão incompatível e migrar para legacy.
        Sessão é considerada legada se:
        - pipeline_version está ausente ou é incompatível
        - Contém campos legados (timestamp, stages, etc)
        """
        if not self.session:
            return
        
        # Versão atual esperada
        expected_version = "1.0.0"
        actual_version = self.session.get("pipeline_version")
        
        legacy_fields = ["timestamp", "stages", "stage0", "stage1", "stage2"]
        has_legacy_fields = any(field in self.session for field in legacy_fields)
        
        if actual_version != expected_version or has_legacy_fields:
            print(f"⚠️  Sessão legada detectada (versão={actual_version}, legacy_fields={has_legacy_fields})")
            
            # Criar diretório legacy
            self.legacy_session_dir.mkdir(parents=True, exist_ok=True)
            
            # Mover para legacy com timestamp
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%z")
            legacy_path = self.legacy_session_dir / f"session_start.{timestamp}.json"
            self.session_file.rename(legacy_path)
            
            print(f"✅ Sessão legada arquivada em: {legacy_path.relative_to(self.root)}")
            
            # Inicializar nova sessão vazia
            self.session = {}
    
    def _get_canonical_modules(self) -> list:
        """Carregar lista de módulos canônicos dinamicamente de MODULE_REGISTRY.yaml."""
        modules = self.module_registry.get("modules", {})
        return list(modules.keys())

    def _check_generate_code_eligibility(self, module: str) -> int:
        """Validação de elegibilidade para generate_code (Ordem 1).

        Regras (em sequência, bloqueante):
        1. Módulo deve estar em status >= 'implementation_ready'.
        2. Deve existir relatório adversarial em _reports/adversarial/<module>/ALL.adversarial.json
           ou qualquer _reports/adversarial/*<module>*.adversarial.json.
        3. overall_status do relatório deve ser 'PASS'.
        Retorna 0 se elegível, 1 caso contrário.
        """
        modules = self.module_registry.get("modules", {})
        mod_data = modules.get(module, {})
        mod_status = mod_data.get("status", "draft_contract")
        eligible_statuses = {
            "implementation_ready",
            "implemented",
            "staging_validated",
            "released",
        }

        if mod_status not in eligible_statuses:
            print(
                f"❌ BLOCKED_GENERATION_INELIGIBLE: módulo '{module}' está em '{mod_status}'.",
                file=sys.stderr,
            )
            print(
                f"   Requerido: {sorted(eligible_statuses)}.",
                file=sys.stderr,
            )
            print(
                "   Siga a sequência: readiness_promotion → adversarial_analysis → generate_code.",
                file=sys.stderr,
            )
            return 1

        # Verificar relatório adversarial
        adversarial_dir = self.root / "_reports" / "adversarial"
        report_found = False
        report_pass = False

        # Path canônico primeiro: _reports/adversarial/<module>/ALL.adversarial.json
        canonical_path = adversarial_dir / module / "ALL.adversarial.json"
        candidates = [canonical_path] + sorted(adversarial_dir.glob(f"*{module}*.adversarial.json"))
        for rpath in candidates:
            if not rpath.exists():
                continue
            try:
                data = json.loads(rpath.read_text(encoding="utf-8"))
            except Exception:
                continue
            report_found = True
            if data.get("overall_status") == "PASS":
                report_pass = True
            break

        if not report_found:
            print(
                f"❌ BLOCKED_GENERATION_INELIGIBLE: módulo '{module}' não possui relatório "
                "de análise adversarial em _reports/adversarial/.",
                file=sys.stderr,
            )
            return 1

        if not report_pass:
            print(
                f"❌ BLOCKED_GENERATION_INELIGIBLE: módulo '{module}' tem relatório adversarial "
                "mas overall_status != PASS. Resolva os achados antes de gerar código.",
                file=sys.stderr,
            )
            return 1

        print(f"✅ Elegibilidade generate_code: módulo='{module}', status='{mod_status}', adversarial=PASS")
        return 0

    def _check_implementation_promotion_eligibility(self, module: str) -> int:
        """Validação de elegibilidade para implementation_promotion.

        Regras (em sequência, bloqueante):
        1. Módulo deve estar exatamente em `implementation_ready`.
        2. Deve existir relatório adversarial PASS para o módulo.
        3. Deve existir pelo menos uma feature `implemented` em FEATURE_REGISTRY.yaml.
        4. Deve existir evidência mínima de runtime em `src/<module>/`.
        """
        modules = self.module_registry.get("modules", {})
        mod_data = modules.get(module, {})
        mod_status = mod_data.get("status", "draft_contract")
        if mod_status != "implementation_ready":
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: módulo '{module}' está em '{mod_status}'.",
                file=sys.stderr,
            )
            print(
                "   Requerido: status exato `implementation_ready`.",
                file=sys.stderr,
            )
            print(
                "   Siga a sequência: readiness_promotion → generate_code → implementation_promotion.",
                file=sys.stderr,
            )
            return 1

        adversarial_dir = self.root / "_reports" / "adversarial"
        canonical_path = adversarial_dir / module / "ALL.adversarial.json"
        candidates = [canonical_path] + sorted(adversarial_dir.glob(f"*{module}*.adversarial.json"))
        report_found = False
        report_pass = False
        for rpath in candidates:
            if not rpath.exists():
                continue
            try:
                data = json.loads(rpath.read_text(encoding="utf-8"))
            except Exception:
                continue
            report_found = True
            if data.get("overall_status") == "PASS":
                report_pass = True
            break

        if not report_found:
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: módulo '{module}' não possui relatório "
                "de análise adversarial em _reports/adversarial/.",
                file=sys.stderr,
            )
            return 1

        if not report_pass:
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: módulo '{module}' tem relatório adversarial "
                "mas overall_status != PASS.",
                file=sys.stderr,
            )
            return 1

        feature_registry_path = self.root / "docs" / "_canon" / "FEATURE_REGISTRY.yaml"
        try:
            feature_registry = self._load_yaml(feature_registry_path)
        except Exception as exc:
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: FEATURE_REGISTRY.yaml indisponível ({exc}).",
                file=sys.stderr,
            )
            return 1

        features = feature_registry.get("features", [])
        has_implemented_feature = any(
            isinstance(entry, dict)
            and entry.get("module") == module
            and entry.get("status") == "implemented"
            for entry in features
        )
        if not has_implemented_feature:
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: módulo '{module}' não possui "
                "feature com status `implemented` em FEATURE_REGISTRY.yaml.",
                file=sys.stderr,
            )
            return 1

        src_dir = self.root / "src" / module
        required_paths = [
            src_dir / "api.py",
            src_dir / "schemas.py",
            src_dir / "tests",
        ]
        missing = [str(path.relative_to(self.root)) for path in required_paths if not path.exists()]
        if missing:
            print(
                f"❌ BLOCKED_IMPLEMENTATION_PROMOTION_INELIGIBLE: evidência mínima de runtime ausente para '{module}'.",
                file=sys.stderr,
            )
            for rel in missing:
                print(f"   - faltando: {rel}", file=sys.stderr)
            return 1

        print(
            f"✅ Elegibilidade implementation_promotion: módulo='{module}', status='{mod_status}', "
            "adversarial=PASS, feature_coverage=OK, runtime=OK"
        )
        return 0

    def _load_latest_contract_report(self) -> tuple[dict | None, str | None]:
        report_path = self.root / "_reports" / "contract_gates" / "latest.json"
        if not report_path.exists():
            return None, f"relatório ausente: {report_path.relative_to(self.root)}"
        try:
            return self._load_json(report_path), None
        except Exception as exc:
            return None, str(exc)

    @staticmethod
    def _gate_status(report: dict, gate_id: str) -> str | None:
        for gate in report.get("gates", []):
            if gate.get("gate_id") == gate_id:
                return gate.get("status")
        return None

    def _check_runtime_promotion_report_prereqs(self, block_code: str) -> tuple[dict | None, int]:
        report, error = self._load_latest_contract_report()
        if report is None:
            print(f"❌ {block_code}: relatório de gates indisponível ({error}).", file=sys.stderr)
            return None, 1
        if report.get("overall_status") != "PASS":
            print(f"❌ {block_code}: _reports/contract_gates/latest.json não está em PASS.", file=sys.stderr)
            return None, 1
        if self._gate_status(report, "DEPLOY_READINESS_GATE") != "PASS":
            print(f"❌ {block_code}: DEPLOY_READINESS_GATE não está em PASS.", file=sys.stderr)
            return None, 1
        return report, 0

    def _check_staging_promotion_eligibility(self, module: str) -> int:
        modules = self.module_registry.get("modules", {})
        mod_data = modules.get(module, {})
        mod_status = mod_data.get("status", "draft_contract")
        if mod_status != "implemented":
            print(
                f"❌ BLOCKED_STAGING_PROMOTION_INELIGIBLE: módulo '{module}' está em '{mod_status}'.",
                file=sys.stderr,
            )
            print("   Requerido: status exato `implemented`.", file=sys.stderr)
            return 1
        report, rc = self._check_runtime_promotion_report_prereqs("BLOCKED_STAGING_PROMOTION_INELIGIBLE")
        if rc != 0:
            return rc
        http_status = self._gate_status(report, "HTTP_RUNTIME_CONTRACT_GATE")
        if http_status not in {"PASS", "SKIP_NOT_APPLICABLE"}:
            print(
                "❌ BLOCKED_STAGING_PROMOTION_INELIGIBLE: HTTP_RUNTIME_CONTRACT_GATE não está elegível.",
                file=sys.stderr,
            )
            return 1
        print(
            f"✅ Elegibilidade staging_promotion: módulo='{module}', status='{mod_status}', "
            "pipeline=PASS, deploy_readiness=PASS"
        )
        return 0

    def _check_release_promotion_eligibility(self, module: str) -> int:
        modules = self.module_registry.get("modules", {})
        mod_data = modules.get(module, {})
        mod_status = mod_data.get("status", "draft_contract")
        if mod_status != "staging_validated":
            print(
                f"❌ BLOCKED_RELEASE_PROMOTION_INELIGIBLE: módulo '{module}' está em '{mod_status}'.",
                file=sys.stderr,
            )
            print("   Requerido: status exato `staging_validated`.", file=sys.stderr)
            return 1
        _, rc = self._check_runtime_promotion_report_prereqs("BLOCKED_RELEASE_PROMOTION_INELIGIBLE")
        if rc != 0:
            return rc
        print(
            f"✅ Elegibilidade release_promotion: módulo='{module}', status='{mod_status}', "
            "pipeline=PASS, deploy_readiness=PASS"
        )
        return 0

    
    def _validate_boot_profile_id(self, profile_id: str) -> bool:
        """Validar que boot_profile_id existe em BOOT_PROFILES.yaml."""
        profiles = self.boot_profiles.get("profiles", {})
        if profile_id not in profiles:
            print(f"❌ boot_profile_id '{profile_id}' não reconhecido", file=sys.stderr)
            print(f"   Profiles válidos: {', '.join(profiles.keys())}", file=sys.stderr)
            return False
        return True

    def _resolve_profile_path(self, raw_path: str) -> pathlib.Path:
        normalized = raw_path[2:] if raw_path.startswith("./") else raw_path
        return self.root / normalized

    def _validate_boot_profile_structure(self, profile_id: str) -> tuple[bool, bool]:
        """Garantir que o profile referencie apenas paths válidos e resolvíveis."""
        profiles = self.boot_profiles.get("profiles", {})
        profile = profiles.get(profile_id, {})
        paths_ok = True
        sections_ok = True

        for raw_path in profile.get("load_sequence", []):
            path = self._resolve_profile_path(str(raw_path))
            if not path.exists():
                print(
                    f"❌ load_sequence inválido em BOOT_PROFILES.yaml: '{raw_path}' não existe",
                    file=sys.stderr,
                )
                paths_ok = False

        for raw_section in profile.get("required_sections", []):
            section_ref = str(raw_section)
            path_part = section_ref.split("§", 1)[0]
            if path_part in {"GATES_REGISTRY.yaml", "CONTRACT_PIPELINE.md", "DECISION_POLICY.md"}:
                path_part = {
                    "GATES_REGISTRY.yaml": "docs/_canon/gates/GATES_REGISTRY.yaml",
                    "CONTRACT_PIPELINE.md": "docs/_canon/CONTRACT_PIPELINE.md",
                    "DECISION_POLICY.md": "docs/_canon/DECISION_POLICY.md",
                }[path_part]
            path = self._resolve_profile_path(path_part)
            if not path.exists():
                print(
                    f"❌ required_sections inválido em BOOT_PROFILES.yaml: '{section_ref}' aponta para arquivo ausente",
                    file=sys.stderr,
                )
                sections_ok = False

        return paths_ok, sections_ok

    def _apply_selection_rules(self, task_type: str) -> str:
        """
        Aplica selection_rules de BOOT_PROFILES.yaml para determinar o profile_id
        correto para o task_type dado. TASK_CATALOG é a fonte de autoridade —
        este método serve apenas para conferência de coerência.
        """
        task_catalog = self.task_catalog.get("task_catalog", {})
        explicit = (task_catalog.get(task_type) or {}).get("profile_id")
        if explicit:
            return explicit
        # Regras declarativas de BOOT_PROFILES.yaml §selection_rules
        if task_type == "execute_roadmap_phase":
            return "roadmap_execution"
        contract_tasks = {"new_contract", "contract_revision", "new_event", "new_workflow", "new_schema"}
        if task_type in contract_tasks:
            return "contract_execution"
        if task_type in {"architecture_review", "decision_discovery"}:
            return "architecture_decision"
        return "default"

    def _check_stage_allowed(self, task_type: str, stage: int) -> bool:
        """
        Valida que o stage atual está em stage_allowed para o task_type.
        Lista vazia em stage_allowed significa sem restrição de stage.
        Quando stage não está na lista, emite código de bloqueio explícito.
        """
        task_catalog = self.task_catalog.get("task_catalog", {})
        stage_allowed = (task_catalog.get(task_type) or {}).get("stage_allowed", [])
        if not stage_allowed:
            return True  # Sem restrição declarada
        if stage not in stage_allowed:
            print(
                f"❌ {self.STAGE_NOT_ALLOWED_BLOCK_CODE}: task_type '{task_type}' declara "
                f"stage_allowed={stage_allowed}; stage atual={stage} fora da janela permitida.",
                file=sys.stderr,
            )
            return False
        return True

    def _validate_required_section_content(self, profile_id: str) -> bool:
        """
        Verifica conteúdo mínimo das required_sections além de existência de path.
        Falha (exit 1) se arquivo obrigatório está vazio.
        Emite aviso (não falha hard) se heading numérica (§0, §1...) não localizada.
        Garante que boot não seja 'verde' apenas por existência de arquivo.
        """
        profiles = self.boot_profiles.get("profiles", {})
        profile = profiles.get(profile_id, {})
        all_good = True

        for raw in profile.get("required_sections", []):
            ref = str(raw)
            if "§" not in ref:
                path = self._resolve_profile_path(ref)
                if path.exists():
                    try:
                        if not path.read_text(encoding="utf-8", errors="replace").strip():
                            print(f"❌ Artefato obrigatório '{ref}' está vazio.", file=sys.stderr)
                            all_good = False
                    except OSError:
                        pass  # Erros de path capturados por _validate_boot_profile_structure
                continue

            path_part, section_marker = ref.split("§", 1)
            path = self._resolve_profile_path(path_part)
            if not path.exists():
                continue  # Capturado por _validate_boot_profile_structure

            try:
                content = path.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                print(f"❌ Falha ao ler '{path_part}': {exc}", file=sys.stderr)
                all_good = False
                continue

            if not content.strip():
                print(f"❌ '{path_part}' está vazio mas requer seção §{section_marker}.", file=sys.stderr)
                all_good = False
                continue

            # Verificação de heading para seções numéricas (§0, §1, §2...)
            if section_marker.isdigit():
                found = any(
                    f"{h}{section_marker}." in content or f"{h}{section_marker} " in content
                    for h in ("## ", "# ")
                )
                if not found:
                    print(
                        f"⚠️  '{path_part}§{section_marker}': heading '## {section_marker}.' não localizada. "
                        "Seção pode ter sido renumerada ou usa formato diferente.",
                        file=sys.stderr,
                    )
                    # Aviso informativo — não falha hard

        return all_good

    def _validate_profile_validations(self, profile_id: str) -> bool:
        """
        Aplica o bloco 'validations' do profile de boot além de verificação de path.
        Regras implementadas:
          - session_handoff_read: SESSION_HANDOFF.md não pode estar vazio se existir
          - roadmap_phase_valid: ROADMAP.md deve existir e ter seções de fase
        Retorna False quando exit_on_fail=true e uma validação obrigatória falha.
        """
        profiles = self.boot_profiles.get("profiles", {})
        profile = profiles.get(profile_id, {})
        raw_validations = profile.get("validations", {})

        # Normalizar: lista-de-dicts → dict plano
        if isinstance(raw_validations, list):
            flat: dict = {}
            for item in raw_validations:
                if isinstance(item, dict):
                    flat.update(item)
            raw_validations = flat

        all_good = True

        # session_handoff_read: true — SESSION_HANDOFF.md, se existir, deve ser não-vazio
        if raw_validations.get("session_handoff_read") is True:
            handoff = self.root / "SESSION_HANDOFF.md"
            if handoff.exists():
                if not handoff.read_text(encoding="utf-8", errors="replace").strip():
                    print(
                        "❌ SESSION_HANDOFF.md existe mas está vazio. "
                        "Preencha ou remova o arquivo antes de continuar.",
                        file=sys.stderr,
                    )
                    all_good = False
                else:
                    print("✅ SESSION_HANDOFF.md presente e não-vazio.")
            else:
                print("ℹ️  SESSION_HANDOFF.md ausente — boot inicial de sessão (aceitável).")

        # roadmap_phase_valid: true — ROADMAP.md deve existir e ter estrutura de fases
        if raw_validations.get("roadmap_phase_valid") is True:
            roadmap = self.root / "ROADMAP.md"
            if not roadmap.exists():
                print(
                    "❌ ROADMAP.md obrigatório para profile 'roadmap_execution' mas não existe.",
                    file=sys.stderr,
                )
                all_good = False
            else:
                road_content = roadmap.read_text(encoding="utf-8", errors="replace")
                if not any(m in road_content for m in ("## Fase", "## FASE", "## Phase", "# Fase")):
                    print(
                        "⚠️  ROADMAP.md existe mas ausência de seções '## Fase N' detectadas.",
                        file=sys.stderr,
                    )
                    # Aviso informativo — formato pode variar

        return all_good

    @staticmethod
    def _determine_write_scope(task_type: str, profile_id: str) -> str:
        """Determinar write_scope da sessão a partir do task_type/profile."""
        docs_tasks = {
            "new_module",
            "new_ui_contract",
            "architecture_review",
            "decision_discovery",
            "readiness_promotion",
            "implementation_promotion",
            "staging_promotion",
            "release_promotion",
        }
        readonly_tasks = {
            "pre_contract_boot",
            "adversarial_analysis",
            "audit_sovereign_integrity",
            "audit_context_efficiency",
            "audit_red_team_pipeline",
            "audit_gate_coverage",
            "audit_domain_completeness",
        }

        if profile_id == "roadmap_execution" or task_type == "execute_roadmap_phase":
            return "roadmap"
        if task_type == "generate_code":
            return "backend"
        if task_type in docs_tasks:
            return "docs"
        if task_type in readonly_tasks or task_type.startswith("audit_"):
            return "readonly"
        return "contracts"
    
    def _save_session(self):
        """Salvar session_start.json."""
        self.session_file.parent.mkdir(parents=True, exist_ok=True)
        with open(self.session_file, "w") as f:
            json.dump(self.session, f, indent=2, ensure_ascii=False)
            f.write("\n")
    
    def _validate_session_against_schema(self) -> bool:
        """Validar sessão contra schema."""
        try:
            jsonschema.validate(self.session, self.session_schema)
            return True
        except jsonschema.ValidationError as e:
            print(f"❌ Sessão inválida: {e.message}", file=sys.stderr)
            return False
    
    def _get_git_branch(self) -> str:
        """Obter branch ativo."""
        try:
            result = subprocess.run(
                ["git", "branch", "--show-current"],
                capture_output=True,
                text=True,
                check=True
            )
            branch = result.stdout.strip()
            if branch:
                return branch
            # Detached HEAD (CI checkout): tentar GITHUB_HEAD_REF, GITHUB_REF_NAME ou ref
            for env_var in ("GITHUB_HEAD_REF", "GITHUB_REF_NAME"):
                val = os.environ.get(env_var, "").strip()
                if val:
                    return val
            result2 = subprocess.run(
                ["git", "rev-parse", "--abbrev-ref", "HEAD"],
                capture_output=True, text=True
            )
            ref = result2.stdout.strip()
            return ref if ref and ref != "HEAD" else "detached"
        except Exception:
            return "unknown"
    
    def cmd_verify(
        self,
        task_type: str,
        module: Optional[str],
        roadmap_phase: Optional[int] = None,
        roadmap_task_id: Optional[str] = None,
    ) -> int:
        """
        FASE 0: SESSION_BOOT

        Validar que task_type e module são válidos.
        Criar/atualizar session_start.json.
        """
        print("\n══ FASE 0: SESSION_BOOT ══")

        # Validação 1: task_type existe em TASK_CATALOG?
        task_catalog = self.task_catalog.get("task_catalog", {})
        if task_type not in task_catalog:
            print(f"❌ task_type '{task_type}' não registrado em TASK_CATALOG.yaml", file=sys.stderr)
            print(f"   Registrados: {', '.join(task_catalog.keys())}", file=sys.stderr)
            return 1

        task_config = task_catalog[task_type]

        # Validação 2: status é active?
        status = task_config.get("status")
        if status == "frozen":
            reason = task_config.get("reason_frozen", "não especificado")
            unblock = task_config.get("unblock_condition", "não especificado")
            print(f"❌ task_type '{task_type}' está FROZEN", file=sys.stderr)
            print(f"   Razão: {reason}", file=sys.stderr)
            print(f"   Desbloquear quando: {unblock}", file=sys.stderr)
            return 1
        elif status != "active":
            print(f"❌ task_type '{task_type}' status={status} (esperado: active)", file=sys.stderr)
            return 1

        # Validação 3: module — obrigatório exceto para execute_roadmap_phase
        is_roadmap_mode = (task_type == "execute_roadmap_phase")
        canonical_modules = self._get_canonical_modules()
        if module is None and not is_roadmap_mode:
            print(
                f"❌ --module é obrigatório para task_type='{task_type}'.",
                file=sys.stderr,
            )
            print(f"   Canônicos: {', '.join(canonical_modules)}", file=sys.stderr)
            return 1
        module_valid = True
        if module is not None and module not in canonical_modules:
            print(f"❌ module '{module}' não é canônico", file=sys.stderr)
            print(f"   Canônicos: {', '.join(canonical_modules)}", file=sys.stderr)
            return 1

        # Validação 4: worker_path existe?
        worker_path = self.root / task_config.get("worker_path", "")
        if not worker_path.exists():
            print(f"❌ Worker prompt não existe: {worker_path}", file=sys.stderr)
            return 1

        # Validação 4b: elegibilidade de módulo para generate_code (BLOCKED_GENERATION_INELIGIBLE)
        if task_type == "generate_code":
            rc = self._check_generate_code_eligibility(module)
            if rc != 0:
                return rc
        elif task_type == "implementation_promotion":
            rc = self._check_implementation_promotion_eligibility(module)
            if rc != 0:
                return rc
        elif task_type == "staging_promotion":
            rc = self._check_staging_promotion_eligibility(module)
            if rc != 0:
                return rc
        elif task_type == "release_promotion":
            rc = self._check_release_promotion_eligibility(module)
            if rc != 0:
                return rc

        # Validação 5: boot_profile_id é válido?
        # Nota: profile_id=null em TASK_CATALOG (ex: audit tasks) → fallback para "default"
        profile_id = task_config.get("profile_id") or "default"
        if not self._validate_boot_profile_id(profile_id):
            return 1
        boot_paths_valid, required_sections_valid = self._validate_boot_profile_structure(profile_id)
        if not boot_paths_valid or not required_sections_valid:
            return 1

        # Validação 5b: selection_rules — coerência informativa (TASK_CATALOG prevalece)
        selected_by_rules = self._apply_selection_rules(task_type)
        if selected_by_rules != profile_id:
            print(
                f"⚠️  selection_rules → '{selected_by_rules}' vs TASK_CATALOG → '{profile_id}' "
                "— TASK_CATALOG é a fonte de autoridade e prevalece.",
                file=sys.stderr,
            )

        # Validação 5c: required_sections — conteúdo mínimo (falha hard para arquivo vazio)
        if not self._validate_required_section_content(profile_id):
            return 1

        # Validação 5d: bloco validations (SESSION_HANDOFF.md, ROADMAP.md)
        validations_ok = self._validate_profile_validations(profile_id)
        exit_on_fail = self.boot_profiles.get("profiles", {}).get(profile_id, {}).get("exit_on_fail", True)
        if not validations_ok and exit_on_fail:
            return 1

        # Validação 5e: stage_allowed — bloqueante
        if not self._check_stage_allowed(task_type, 0):
            return 1

        # Derivar campos de modo
        operation_mode = "ROADMAP" if profile_id == "roadmap_execution" else "CDD"
        module_focus = module  # pode ser None em modo ROADMAP sem --module

        # Tudo OK — criar/atualizar sessão
        if module is not None:
            print(f"✅ task_type='{task_type}' (active, worker exists)")
            print(f"✅ module='{module}' (canonical)")
        else:
            print(f"✅ task_type='{task_type}' (active, worker exists) [modo ROADMAP sem módulo fixo]")
        print(f"✅ boot_profile_id='{profile_id}' (valid) | operation_mode={operation_mode}")
        print("✅ boot_profile structure (paths + required_sections resolvíveis)")

        # Inicializar/atualizar session
        if "session_id" not in self.session:
            self.session["session_id"] = str(uuid.uuid4())

        session_update: dict = {
            "session_timestamp": datetime.now(timezone.utc).isoformat(),
            "branch": self._get_git_branch(),
            "pipeline_version": "1.0.0",
            "boot_profile_id": profile_id,
            "task_type": task_type,
            "stage": 0,
            "write_scope": self._determine_write_scope(task_type, profile_id),
            "worker_id": task_config.get("worker_id"),
            "git_user": self._get_git_user(),
            "git_email": self._get_git_email(),
            "operation_mode": operation_mode,
            "stage0_validation_results": {
                "task_type_valid": True,
                "module_valid": module_valid,
                "worker_exists": True,
                "boot_profile_exists": True,
                "boot_paths_valid": boot_paths_valid,
                "required_sections_resolvable": required_sections_valid,
            },
        }

        # Campos opcionais — incluir apenas quando disponíveis
        if module is not None:
            session_update["module"] = module
        if module_focus is not None:
            session_update["module_focus"] = module_focus
        if roadmap_phase is not None:
            session_update["roadmap_phase"] = roadmap_phase
        if roadmap_task_id is not None:
            session_update["roadmap_task_id"] = roadmap_task_id

        self.session.update(session_update)
        
        # Validar contra schema
        if not self._validate_session_against_schema():
            return 1
        
        # Salvar
        self._save_session()
        
        # Executar phase 0 do validator
        result = subprocess.run(
            [sys.executable, str(self.validator_script), "--stage", "session-start"],
            capture_output=False
        )
        
        self.session["stage0_exit_code"] = result.returncode
        self._save_session()
        
        print(f"\nDONE = exitcode 0  |  atual exitcode = {result.returncode}\n")
        return result.returncode
    
    def cmd_check(self, module: str) -> int:
        """
        FASE 1: PRE_AUTHORING
        
        Validar readiness do módulo.
        """
        print("\n══ FASE 1: PRE_AUTHORING ══")
        
        # Validar que sessão foi inicializada
        if "task_type" not in self.session or "session_id" not in self.session:
            print("❌ Sessão não inicializada. Execute 'hb verify --task-type <task> --module <mod>' primeiro", file=sys.stderr)
            return 1
        
        # Validar que module corresponde
        if self.session.get("module") != module:
            print(f"❌ Module mismatch: sessão tem '{self.session.get('module')}', você passou '{module}'", file=sys.stderr)
            return 1
        
        print(f"✅ Sessão validada: task_type={self.session.get('task_type')}, module={module}")

        # Validação bloqueante de stage_allowed para stage 1
        task_type_s = self.session.get("task_type", "")
        if task_type_s:
            if not self._check_stage_allowed(task_type_s, 1):
                return 1

        # Atualizar stage
        self.session["stage"] = 1
        self._save_session()
        
        # Executar phase 1 do validator
        result = subprocess.run(
            [sys.executable, str(self.validator_script), "--stage", "pre-authoring", "--module", module],
            capture_output=False
        )
        
        self.session["stage1_exit_code"] = result.returncode
        self._save_session()
        
        print(f"\nDONE = exitcode 0  |  atual exitcode = {result.returncode}\n")
        return result.returncode
    
    def cmd_artifact(self, artifact_path: str) -> int:
        """
        FASE 2: PER_ARTIFACT
        
        Validar artefato. Fazer upsert com hash SHA-256.
        """
        print(f"\n══ FASE 2: PER_ARTIFACT | {artifact_path} ══")

        # Validação bloqueante de stage_allowed para stage 2
        task_type_a = self.session.get("task_type", "")
        if task_type_a:
            if not self._check_stage_allowed(task_type_a, 2):
                return 1

        artifact_full = self.root / artifact_path
        if not artifact_full.exists():
            print(f"❌ Artefato não existe: {artifact_path}", file=sys.stderr)
            return 1
        
        # Calcular hash
        artifact_hash = self._calculate_file_hash(artifact_full)
        
        # Atualizar stage
        self.session["stage"] = 2
        
        # Upsert artifact
        artifacts = self.session.setdefault("stage2_artifacts", [])
        existing = next((a for a in artifacts if a["path"] == artifact_path), None)
        
        if existing:
            print(f"📝 Artefato já em session (hash anterior: {existing['sha256'][:8]}...)")
            existing["sha256"] = artifact_hash
            existing["validated_at"] = datetime.now(timezone.utc).isoformat()
        else:
            print(f"✅ Novo artefato")
            artifacts.append({
                "path": artifact_path,
                "sha256": artifact_hash,
                "created_at": datetime.now(timezone.utc).isoformat(),
            })
        
        self._save_session()
        
        # Executar phase 2 do validator
        result = subprocess.run(
            [sys.executable, str(self.validator_script), "--stage", "artifact", "--artifact", artifact_path],
            capture_output=False
        )
        
        # Atualizar resultado do gate
        artifact_obj = next(a for a in artifacts if a["path"] == artifact_path)
        artifact_obj["gate_exit_code"] = result.returncode
        # Persistir stage2_exit_code no estado da sessão (substitui pelo exit code mais recente)
        self.session["stage2_exit_code"] = result.returncode
        self._save_session()

        print(f"\nDONE = exitcode 0  |  atual exitcode = {result.returncode}\n")
        return result.returncode

    def cmd_stage3(self) -> int:
        """
        FASE 3: VALIDATE_CONTRACTS (full run)

        Roda validate_contracts.py completo e persiste stage3_exit_code na sessão.
        Deve ser executado após todos os artefatos terem sido criados e registrados.
        """
        print("\n══ FASE 3: VALIDATE_CONTRACTS (full run) ══")

        if "task_type" not in self.session:
            print("❌ Sessão não inicializada. Execute 'hb verify' antes de 'hb stage3'.", file=sys.stderr)
            return 1

        python_bin = self._ensure_local_contract_env(
            "hb stage3",
            python_modules=("yaml", "jsonschema", "schemathesis"),
            cli_tools=("oasdiff", "redocly", "spectral", "asyncapi"),
            cli_groups=(("st", "schemathesis"),),
        )
        if python_bin is None:
            return 2

        for module in self._discover_source_graph_modules():
            print(f"Verificando source graph derivado: {module}")
            compile_result = self._run_source_graph_compiler(python_bin, module=module, check=True)
            if compile_result != 0:
                print(f"❌ Source graph compiler check falhou para `{module}`.", file=sys.stderr)
                return compile_result

        print("Rodando validate_contracts.py --profile ci ...")
        result = subprocess.run(
            [str(python_bin), str(self.validator_script), "--profile", "ci"],
            capture_output=False,
            cwd=self.root,
            env=self._build_tool_env(),
        )

        self.session["stage3_exit_code"] = result.returncode
        self._save_session()

        status = "✅ PASS" if result.returncode == 0 else f"❌ FAIL (exit {result.returncode})"
        print(f"\nstage3_exit_code={result.returncode} | {status}")
        print(f"\nDONE = exitcode 0  |  atual exitcode = {result.returncode}\n")
        return result.returncode

    def cmd_status(self) -> int:
        """Mostrar status completo da sessão."""
        print("\n══ ESTADO COMPLETO DO PIPELINE ══\n")

        if not self.session:
            print("❌ Nenhuma sessão ativa")
            return 1

        print(f"Session ID: {self.session.get('session_id', 'N/A')}")
        print(f"Task Type: {self.session.get('task_type', 'N/A')}")
        print(f"Module: {self.session.get('module', 'N/A')}")
        print(f"Branch: {self.session.get('branch', 'N/A')}")
        print(f"Stage: {self.session.get('stage', 'N/A')}")
        
        if "stage0_exit_code" in self.session:
            code = self.session["stage0_exit_code"]
            status = "✅ PASS" if code == 0 else f"❌ FAIL ({code})"
            print(f"Phase 0 (boot): {status}")
        
        if "stage1_exit_code" in self.session:
            code = self.session["stage1_exit_code"]
            status = "✅ PASS" if code == 0 else f"❌ FAIL ({code})"
            print(f"Phase 1 (discovery): {status}")
        
        if "stage2_artifacts" in self.session:
            print(f"Phase 2 (artifacts): {len(self.session['stage2_artifacts'])} artefato(s)")
            for art in self.session["stage2_artifacts"]:
                code = art.get("gate_exit_code", "?")
                status = "✅" if code == 0 else f"❌ ({code})"
                print(f"  {status} {art['path']} (hash: {art['sha256'][:8]}...)")

        return 0

    def cmd_compile_source_graph(self, module: str, *, check: bool = False) -> int:
        """Compilar/verificar source graph derivado de um módulo piloto."""
        mode_label = "CHECK" if check else "WRITE"
        print(f"\n══ SOURCE GRAPH COMPILER | {module} | {mode_label} ══")

        python_bin = self._ensure_local_contract_env(
            "hb compile-source-graph",
            python_modules=("yaml",),
        )
        if python_bin is None:
            return 2

        result = self._run_source_graph_compiler(python_bin, module=module, check=check)
        if result == 0:
            print("\n✅ Source graph compiler: PASS")
        else:
            print("\n❌ Source graph compiler: FAIL")
        return result

    def cmd_compile_ops_contracts(self, *, check: bool = False) -> int:
        """Compilar/verificar derivados dos contratos operacionais."""
        mode_label = "CHECK" if check else "WRITE"
        print(f"\n══ OPS CONTRACT COMPILER | {mode_label} ══")

        python_bin = self._ensure_local_contract_env(
            "hb compile-ops-contracts",
            python_modules=("yaml",),
        )
        if python_bin is None:
            return 2

        result = self._run_ops_contract_compiler(python_bin, check=check)
        if result == 0:
            print("\n✅ Ops contract compiler: PASS")
        else:
            print("\n❌ Ops contract compiler: FAIL")
        return result

    def cmd_compile_context_bundle(self, module: str, *, check: bool = False) -> int:
        """Compilar/verificar bundles determinísticos por módulo/feature."""
        mode_label = "CHECK" if check else "WRITE"
        print(f"\n══ CONTEXT BUNDLE COMPILER | {module} | {mode_label} ══")

        python_bin = self._ensure_local_contract_env(
            "hb compile-context-bundle",
            python_modules=("yaml",),
        )
        if python_bin is None:
            return 2

        result = self._run_context_bundle_compiler(python_bin, module=module, check=check)
        if result == 0:
            print("\n✅ Context bundle compiler: PASS")
        else:
            print("\n❌ Context bundle compiler: FAIL")
        return result
    
    def cmd_survival_suite(self) -> int:
        """Rodar suíte de sobrevivência obrigatória.

        Deve passar antes de qualquer mudança em:
        gates, profiles, task catalog, schemas críticos, validate_contracts.py,
        bridge docs (.github/skills, .github/copilot-instructions.md), prompts
        (.contract_driven/agent_prompts/**) ou templates (docs/_canon/templates/**).
        """
        SURVIVAL_SUITE = [
            "tests/test_pipeline_governance.py",
            "tests/pipeline_gates/test_phase_0_determinism.py",
            "tests/pipeline_gates/test_context_budgets_and_parity.py::TestSSOTParity",
            "tests/pipeline_gates/test_context_budgets_and_parity.py::TestHookIntegrity",
            "tests/pipeline_gates/test_context_budgets_and_parity.py::TestZeroBootProfileReferences",
            "tests/pipeline_gates/test_context_budgets_and_parity.py::test_parity_cli_verify",
            "tests/pipeline_gates/test_tooling_config_gate.py",
            # FASE 3 — modelo único de estado de sessão
            "tests/pipeline_gates/test_session_state_phase3.py",
            # FASE 4 — paridade schema/template/skills/prompts
            "tests/pipeline_gates/test_schema_template_parity_phase4.py",
        ]
        print("\n══ SURVIVAL SUITE ══")
        print("Testes obrigatórios antes de mudança em gates/profiles/task_catalog/schemas/bridge-docs\n")
        python_bin = self._ensure_local_contract_env(
            "hb survival-suite",
            python_modules=("pytest",),
        )
        if python_bin is None:
            return 2
        result = subprocess.run(
            [str(python_bin), "-m", "pytest", *SURVIVAL_SUITE, "-v"],
            cwd=self.root,
            env=self._build_tool_env(),
        )
        if result.returncode == 0:
            print("\n✅ Survival suite: PASS — seguro prosseguir.")
        else:
            print("\n❌ Survival suite: FAIL — não avançar sem suíte verde.")
        return result.returncode

    def cmd_reset(self) -> int:
        """Limpar sessão (novo boot)."""
        print("\n══ RESET: Limpando sessão ══")
        
        if self.session_file.exists():
            self.session_file.unlink()
            print("✅ session_start.json removido")
        
        self.session = {}
        print("✅ Sessão limpa. Execute 'hb verify' para nova sessão.\n")
        return 0
    
    @staticmethod
    def _calculate_file_hash(path: pathlib.Path) -> str:
        """Calcular SHA-256 do arquivo."""
        sha256 = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(8192), b""):
                sha256.update(chunk)
        return sha256.hexdigest()

    def _discover_source_graph_modules(self) -> list[str]:
        modules: list[str] = []
        base = self.root / "docs" / "hbtrack" / "modulos"
        if not base.exists():
            return modules
        for manifest in sorted(base.glob("*/graph/module_manifest.yaml")):
            modules.append(manifest.parent.parent.name)
        return modules

    def _run_source_graph_compiler(self, python_bin: pathlib.Path, *, module: str, check: bool) -> int:
        command = [
            str(python_bin),
            str(self.source_graph_compiler_script),
            "--module",
            module,
        ]
        if check:
            command.append("--check")
        result = subprocess.run(
            command,
            capture_output=False,
            cwd=self.root,
            env=self._build_tool_env(),
        )
        return result.returncode

    def _run_ops_contract_compiler(self, python_bin: pathlib.Path, *, check: bool) -> int:
        command = [
            str(python_bin),
            str(self.ops_contract_compiler_script),
        ]
        if check:
            command.append("--check")
        result = subprocess.run(
            command,
            capture_output=False,
            cwd=self.root,
            env=self._build_tool_env(),
        )
        return result.returncode

    def _run_context_bundle_compiler(self, python_bin: pathlib.Path, *, module: str, check: bool) -> int:
        command = [
            str(python_bin),
            str(self.context_bundle_compiler_script),
            "--module",
            module,
        ]
        if check:
            command.append("--check")
        result = subprocess.run(
            command,
            capture_output=False,
            cwd=self.root,
            env=self._build_tool_env(),
        )
        return result.returncode
    
    @staticmethod
    def _get_git_user() -> str:
        """Obter git user.name."""
        try:
            result = subprocess.run(
                ["git", "config", "user.name"],
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()
        except Exception:
            return "unknown"
    
    @staticmethod
    def _get_git_email() -> str:
        """Obter git user.email."""
        try:
            result = subprocess.run(
                ["git", "config", "user.email"],
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()
        except Exception:
            return "unknown@example.com"
    
    def run(self, args: Optional[list] = None) -> int:
        """Executar CLI."""
        parser = argparse.ArgumentParser(
            prog="hb",
            description="HB Track Pipeline CLI (v2 — determinístico)",
        )
        
        subparsers = parser.add_subparsers(dest="command", help="Comando")
        
        # verify
        verify_p = subparsers.add_parser("verify", help="Fase 0: Boot e validação de sessão")
        verify_p.add_argument("--task-type", required=True, help="Task type (deve estar em TASK_CATALOG)")
        verify_p.add_argument("--module", required=False, default=None,
                              help="Módulo canônico (um dos 17). Obrigatório exceto para execute_roadmap_phase.")
        verify_p.add_argument("--roadmap-phase", type=int, default=None,
                              help="Fase do ROADMAP em execução (0-13). Usado apenas em modo ROADMAP.")
        verify_p.add_argument("--roadmap-task-id", default=None,
                              help="Identificador da tarefa roadmap (ex: 'phase-1-foundation').")
        
        # check
        check_p = subparsers.add_parser("check", help="Fase 1: Validação de módulo")
        check_p.add_argument("--module", required=True, help="Módulo canônico")
        
        # artifact
        artifact_p = subparsers.add_parser("artifact", help="Fase 2: Validação de artefato per-file")
        artifact_p.add_argument("path", help="Caminho do artefato (relativo ao workspace)")
        
        # status
        subparsers.add_parser("status", help="Mostrar status completo da sessão")
        
        # reset
        subparsers.add_parser("reset", help="Limpar sessão (novo boot)")

        # survival-suite
        subparsers.add_parser(
            "survival-suite",
            help="Rodar suíte de sobrevivência (obrigatório antes de mudança em gates/profiles/schemas)",
        )

        # stage3 — validar contratos (full run) e registrar stage3_exit_code
        subparsers.add_parser(
            "stage3",
            help="FASE 3: rodar validate_contracts.py completo e registrar stage3_exit_code",
        )

        compile_graph_p = subparsers.add_parser(
            "compile-source-graph",
            help="Compilar ou verificar os derivados do source graph de um módulo",
        )
        compile_graph_p.add_argument("--module", required=True, help="Módulo com source graph ativo")
        compile_graph_p.add_argument("--check", action="store_true", help="Não escreve; apenas verifica drift")

        compile_ops_p = subparsers.add_parser(
            "compile-ops-contracts",
            help="Compilar ou verificar os derivados dos contratos operacionais",
        )
        compile_ops_p.add_argument("--check", action="store_true", help="Não escreve; apenas verifica drift")

        compile_context_p = subparsers.add_parser(
            "compile-context-bundle",
            help="Compilar ou verificar bundles determinísticos por módulo/feature",
        )
        compile_context_p.add_argument("--module", required=True, help="Módulo com source graph ativo")
        compile_context_p.add_argument("--check", action="store_true", help="Não escreve; apenas verifica drift")

        # help
        subparsers.add_parser("help", help="Mostrar ajuda")
        
        parsed_args = parser.parse_args(args)
        
        if not parsed_args.command or parsed_args.command == "help":
            parser.print_help()
            return 0
        
        try:
            if parsed_args.command == "verify":
                return self.cmd_verify(
                    parsed_args.task_type,
                    parsed_args.module,
                    roadmap_phase=getattr(parsed_args, "roadmap_phase", None),
                    roadmap_task_id=getattr(parsed_args, "roadmap_task_id", None),
                )
            elif parsed_args.command == "check":
                return self.cmd_check(parsed_args.module)
            elif parsed_args.command == "artifact":
                return self.cmd_artifact(parsed_args.path)
            elif parsed_args.command == "status":
                return self.cmd_status()
            elif parsed_args.command == "reset":
                return self.cmd_reset()
            elif parsed_args.command == "survival-suite":
                return self.cmd_survival_suite()
            elif parsed_args.command == "stage3":
                return self.cmd_stage3()
            elif parsed_args.command == "compile-source-graph":
                return self.cmd_compile_source_graph(parsed_args.module, check=parsed_args.check)
            elif parsed_args.command == "compile-ops-contracts":
                return self.cmd_compile_ops_contracts(check=parsed_args.check)
            elif parsed_args.command == "compile-context-bundle":
                return self.cmd_compile_context_bundle(parsed_args.module, check=parsed_args.check)
        except FileNotFoundError as e:
            print(f"❌ {e}", file=sys.stderr)
            return 2
        except Exception as e:
            print(f"❌ Erro inesperado: {e}", file=sys.stderr)
            return 2
        
        return 0


def main():
    """Entrypoint."""
    cli = HBCLIv2()
    sys.exit(cli.run())


if __name__ == "__main__":
    main()
