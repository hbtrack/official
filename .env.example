# ============================================================================
# HB Track — Contrato mínimo de variáveis de ambiente
# Stack: Django 5.x + Django Ninja + PostgreSQL 16 + Celery 5 + Channels 4
# Gerado: 2026-04-09 (SAN-003)
# ============================================================================
# USAGE:
#   cp .env.example .env
#   Preencher valores marcados com CHANGE_ME
#   Variáveis com default seguro para dev podem ficar como estão
# ============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME                          # Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=true                                     # false em staging/prod
ALLOWED_HOSTS=*                                # staging: staging.handballtrack.app,<VPS_IP>
LOG_LEVEL=INFO                                 # DEBUG | INFO | WARNING

# ── PostgreSQL (Django ORM) ──────────────────────────────────────────────────
DB_NAME=hb_track_dev
DB_USER=hbtrack_dev
DB_PASSWORD=hbtrack_dev_pwd                    # CHANGE_ME em staging/prod
DB_HOST=localhost                              # docker-compose prod: postgres
DB_PORT=5433                                   # docker-compose dev: 5432
DB_TEST_NAME=hb_track_test

# Variáveis consumidas pelo container postgres (docker-compose.prod.yml)
POSTGRES_DB=hb_track_dev
POSTGRES_USER=hbtrack_dev
POSTGRES_PASSWORD=hbtrack_dev_pwd              # CHANGE_ME — deve coincidir com DB_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0             # docker-compose prod: redis://redis:6379/0

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0     # se omitido, usa REDIS_URL

# ── JWT / Autenticação ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256                            # HS256 (dev) | RS256 (prod)
JWT_SECRET=CHANGE_ME                           # obrigatório se JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60             # default: 60
# JWT_PRIVATE_KEY=                             # obrigatório se JWT_ALGORITHM=RS256 (base64)
# JWT_PUBLIC_KEY=                              # obrigatório se JWT_ALGORITHM=RS256 (base64)

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Docker / Deploy (só staging/prod) ────────────────────────────────────────
# REGISTRY=ghcr.io/hbtrack
# IMAGE_TAG=latest
# NGINX_CONF=nginx.staging.conf

# ============================================================================
# VARIÁVEIS NÃO USADAS PELO STACK DJANGO ATUAL (legado ou futuro)
# ============================================================================
# As variáveis abaixo NÃO são consumidas pelo código atual.
# Mantidas aqui como referência — NÃO incluir no .env ativo.
#
# LEGADO FastAPI/Alembic (removido em ADR-031):
#   DATABASE_URL=postgresql+asyncpg://...      # driver asyncpg — Django usa django.db.backends.postgresql
#   DATABASE_URL_SYNC=postgresql+psycopg2://... # Alembic — Django usa manage.py migrate
#   DB_POOL_SIZE, DB_MAX_OVERFLOW, DB_POOL_PRE_PING, DB_POOL_TIMEOUT, DB_POOL_RECYCLE
#                                               # SQLAlchemy pool — Django gerencia pool próprio
#   API_VERSION, API_TITLE, API_DESCRIPTION     # FastAPI metadata
#   ENV=local                                   # não lido por nenhum código Django
#
# LEGADO nome incorreto:
#   CORS_ORIGINS=...                           # Django lê CORS_ALLOWED_ORIGINS
#   CORS_ALLOW_CREDENTIALS=...                 # hardcoded True em settings.py
#   JWT_EXPIRES_MINUTES=...                    # código lê JWT_ACCESS_TOKEN_EXPIRY_MINUTES
#
# FUTURO (serviços não implementados — sem consumidor em src/):
#   CLOUDINARY_URL, CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   CLOUDINARY_UPLOAD_PRESET, CLOUDINARY_ASSET
#   RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_FROM_NAME
#   GEMINI_API_KEY
#   FRONTEND_URL
#   CACHE_TTL_VINCULOS, CACHE_TTL_PERMISSOES
#
# OVERRIDDEN pelo settings.py (valor do .env ignorado):
#   CELERY_RESULT_BACKEND=redis://...          # settings.py hardcoda "django-db"
#   CELERY_TIMEZONE=America/Sao_Paulo          # settings.py hardcoda "UTC"
#   CELERY_TASK_TRACK_STARTED=true             # settings.py hardcoda True
#   CELERY_TASK_TIME_LIMIT, CELERY_WORKER_MAX_TASKS_PER_CHILD  # não lidos
#   FLOWER_PORT, FLOWER_BASIC_AUTH             # Flower não configurado no stack
#   PGDATA=/var/lib/postgresql/data            # só faz sentido dentro do container
